# Secrets / local state — never commit
.env
.call_counter.json

# Python
__pycache__/
*.pyc

# Vendored packages (installed locally, e.g. meta-sam-parser)
tools/pylibs/

# Deployment runtime state (ephemeral tunnel URL, pids, logs)
# Production URL memo stays local only — public repo must not carry it
deploy/production_url.local.txt
deploy/current_url.txt
deploy/*.pid
deploy/logs/

# Large eval media — videos stay out of git; licences + manifest are kept
# (see eval/data/SOURCES.md and eval/clips_manifest.json)
eval/data/*.mp4
eval/data/*.webm
eval/data/*.mov
eval/data/verification_videos/*.mp4

# Master verification videos — local only (catalog in videos/README.md is kept;
# web-serving compressed copies in webapp/videos/ are tracked instead)
videos/**/*.mp4

# Local tool state
.playwright-cli/
.tmp/

# macOS
.DS_Store
